# StellarFlow frontend environment — copy to `.env` and fill in your values.
#
# `.env` is gitignored (never commit real contract IDs); this `.env.example`
# documents every variable the frontend reads. The canonical list is also
# documented at the top of `src/config/contracts.ts`.

# Network to target: "public" | "testnet" | "futurenet" | "standalone"
# (defaults to "testnet" if omitted).
VITE_STELLAR_NETWORK=testnet

# Soroban RPC endpoint (defaults to https://soroban-testnet.stellar.org).
VITE_RPC_URL=

# Deployed contract addresses (C... strkeys). Required — `src/config/contracts.ts`
# refuses to boot without them. Replace these with the IDs printed by
# `stellar contract deploy` / `soroban deploy` for each contract.
VITE_FACTORY_CONTRACT_ID=
VITE_ESCROW_CONTRACT_ID=
VITE_PAYMENT_VAULT_CONTRACT_ID=
VITE_TOKEN_CONTRACT_ID=
